{% if state == 'ok' %}
<div class="layout lc-layout lc-half-v">
  <div class="label label--small lg:label--large lc-kicker">Lifetime in 24 hours</div>
  <img class="lc-clock w--[210px] lg:w--[440px]" src="data:image/svg+xml;base64,{{ life_clock_svg | base64_encode }}" alt="Life Clock at {{ life_clock }}">
  <div class="value value--xlarge lg:value--xxlarge value--tnums lc-time">{{ life_clock }}</div>
  <div class="description description--large lg:description--xlarge lc-percent">{{ progress_percent }}% lived</div>
  <img class="lc-progress w--[300px] lg:w--[560px] h--[28px] lg:h--[46px]" src="data:image/svg+xml;base64,{{ progress_svg | base64_encode }}" alt="{{ progress_percent }} percent lived">
  <div class="description description--xsmall lg:description--small lc-note">{{ clock_remaining }} left{% if show_remaining %} · ≈{{ remaining_display }} stat. years{% endif %}</div>
  <div class="hidden lg:visible w--full">
    <div class="lc-half-v__stats">
      <div class="lc-stat">
        <div class="value value--large value--tnums">{{ age_display }}</div>
        <div class="label label--base">Age now</div>
      </div>
      <div class="lc-stat">
        <div class="value value--large value--tnums">{{ expected_age_display }}</div>
        <div class="label label--base">Statistical lifetime</div>
      </div>
    </div>
  </div>
</div>
{% else %}
<div class="layout lc-layout lc-error"><div class="title title--large">{{ headline }}</div><div class="description">{{ detail }}</div></div>
{% endif %}

<div class="title_bar">
  <span class="lc-title-icon">{{ title_icon }}</span>
  <span class="title">Life Clock</span>
  <span class="instance">{{ country_name | truncate: 24 }}{% if data_year %} · {{ data_year }}{% endif %}</span>
</div>
