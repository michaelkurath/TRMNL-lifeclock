{%- comment -%}
Life Clock shared markup.
All demographic and date calculations are performed in Serverless (transform.js).
The view layer only renders the resulting population estimate.
{%- endcomment -%}

{%- capture life_clock_svg -%}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 240" role="img" aria-label="24-hour life clock showing {{ life_clock }}">
  <circle cx="120" cy="120" r="108" fill="none" stroke="#000" stroke-width="3"/>
  <circle cx="120" cy="120" r="95" fill="none" stroke="#000" stroke-width="1"/>
  {% for i in (0..23) %}
    {% assign tick_angle = i | times: 15 %}
    {% assign major = i | modulo: 6 %}
    <g transform="rotate({{ tick_angle }} 120 120)">
      {% if major == 0 %}
        <line x1="120" y1="15" x2="120" y2="32" stroke="#000" stroke-width="4" stroke-linecap="round"/>
      {% else %}
        <line x1="120" y1="18" x2="120" y2="28" stroke="#000" stroke-width="2" stroke-linecap="round"/>
      {% endif %}
    </g>
  {% endfor %}
  <text x="120" y="49" text-anchor="middle" font-family="sans-serif" font-size="16" font-weight="700">00</text>
  <text x="194" y="125" text-anchor="middle" font-family="sans-serif" font-size="16" font-weight="700">06</text>
  <text x="120" y="202" text-anchor="middle" font-family="sans-serif" font-size="16" font-weight="700">12</text>
  <text x="46" y="125" text-anchor="middle" font-family="sans-serif" font-size="16" font-weight="700">18</text>
  <g transform="rotate({{ hand_angle }} 120 120)">
    <line x1="120" y1="132" x2="120" y2="55" stroke="#000" stroke-width="7" stroke-linecap="round"/>
  </g>
  <circle cx="120" cy="120" r="8" fill="#000"/>
</svg>
{%- endcapture -%}

{%- capture progress_svg -%}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 34" preserveAspectRatio="none" role="img" aria-label="{{ progress_percent }} percent of statistical lifetime lived">
  <rect x="1" y="1" width="598" height="32" rx="8" fill="#fff" stroke="#000" stroke-width="2"/>
  <rect x="2" y="2" width="{{ progress_percent | times: 5.96 }}" height="30" rx="7" fill="#000"/>
</svg>
{%- endcapture -%}

{%- capture title_icon -%}
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
  <circle cx="12" cy="12" r="9.5" fill="none" stroke="#000" stroke-width="2"/>
  <path d="M12 12V5M12 12l5 3" fill="none" stroke="#000" stroke-width="2.4" stroke-linecap="round"/>
  <circle cx="12" cy="12" r="2" fill="#000"/>
</svg>
{%- endcapture -%}

<style>
  .lc-layout { box-sizing: border-box; height: 100%; width: 100%; color: #000; }
  .lc-layout * { box-sizing: border-box; }
  .lc-clock { display: block; max-width: 100%; height: auto; }
  .lc-progress { display: block; width: 100%; }
  .lc-kicker { font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .lc-time { font-weight: 700; letter-spacing: -.045em; line-height: .92; }
  .lc-percent { font-weight: 700; line-height: 1; }
  .lc-note { line-height: 1.2; }
  .lc-progress-note { margin-top: 7px; }
  .lc-rule { height: 2px; background: #000; width: 100%; }
  .lc-title-icon { display: inline-flex; width: 24px; height: 24px; }

  .lc-full { display: flex; flex-direction: column; gap: 12px; }
  .lc-full__head { display: flex; align-items: center; gap: 14px; }
  .lc-full__head .lc-rule { flex: 1; }
  .lc-full__body { display: grid; grid-template-columns: minmax(0, 42fr) minmax(0, 58fr); gap: 24px; flex: 1; min-height: 0; }
  .lc-full__dial { display: flex; align-items: center; justify-content: center; min-width: 0; }
  .lc-full__readout { display: flex; flex-direction: column; justify-content: space-between; min-width: 0; padding: 8px 0 2px; }
  .lc-full__stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .lc-full__stats--two { grid-template-columns: repeat(2, 1fr); }
  .lc-stat { border-top: 2px solid #000; padding-top: 8px; }

  .lc-half-h { display: grid; grid-template-columns: minmax(0, 42fr) minmax(0, 58fr); gap: 18px; align-items: center; }
  .lc-half-h .lc-clock { margin: 0 auto; }
  .lc-half-h__right { min-width: 0; }
  .lc-half-h .lc-percent { margin-top: 8px; }

  .lc-half-v { display: flex; flex-direction: column; gap: 10px; align-items: center; justify-content: space-between; text-align: center; }
  .lc-half-v__stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; width: 100%; max-width: 620px; }
  .lc-half-v__stats .lc-stat { text-align: left; }

  .lc-quadrant { display: grid; grid-template-columns: minmax(0, 44fr) minmax(0, 56fr); gap: 12px; align-items: center; }
  .lc-quadrant .lc-clock { margin: 0 auto; }
  .lc-quadrant .lc-percent { margin-top: 8px; }
  .lc-quadrant .lc-note { margin-top: 8px; }

  .lc-error { display: flex; flex-direction: column; justify-content: center; gap: 12px; height: 100%; }
  .lc-error__title { font-size: 36px; font-weight: 800; }
  .lc-error__detail { font-size: 20px; }
</style>
