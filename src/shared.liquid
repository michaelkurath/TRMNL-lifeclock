{%- comment -%}
Life Clock shared markup.
All demographic and date calculations are performed in Serverless (transform.js).
The view layer only renders the resulting population estimate.
TRMNLP custom-field references (used by Serverless): birth_date sex country_code language show_remaining show_horizon
{%- endcomment -%}

{%- capture life_clock_svg -%}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 240" role="img" aria-label="24-hour life clock showing {{ life_clock }}">
  <circle cx="120" cy="120" r="108" fill="none" stroke="#000" stroke-width="3"/>
  <circle cx="120" cy="120" r="95" fill="none" stroke="#000" stroke-width="1"/>
  {% for i in (0..23) %}
    {% assign tick_angle = i | times: 15 %}
    {% assign major = i | modulo: 6 %}
    <g transform="rotate({{ tick_angle }} 120 120)">
      {% if major == 0 %}
        <line x1="120" y1="15" x2="120" y2="32" stroke="#000" stroke-width="4" stroke-linecap="round"/>
      {% else %}
        <line x1="120" y1="18" x2="120" y2="28" stroke="#000" stroke-width="2" stroke-linecap="round"/>
      {% endif %}
    </g>
  {% endfor %}
  <g font-family="sans-serif" font-size="16" font-weight="700">
    <text x="120" y="49" text-anchor="middle">00</text>
    <text x="194" y="125" text-anchor="middle">06</text>
    <text x="120" y="202" text-anchor="middle">12</text>
    <text x="46" y="125" text-anchor="middle">18</text>
  </g>
  <g transform="rotate({{ hand_angle }} 120 120)">
    <line x1="120" y1="132" x2="120" y2="55" stroke="#000" stroke-width="7" stroke-linecap="round"/>
  </g>
  <circle cx="120" cy="120" r="8" fill="#000"/>
</svg>
{%- endcapture -%}

{%- capture progress_svg -%}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 34" preserveAspectRatio="none" role="img" aria-label="{{ progress_percent }} percent of statistical lifetime lived">
  <rect x="1" y="1" width="598" height="32" rx="8" fill="#fff" stroke="#000" stroke-width="2"/>
  <rect x="2" y="2" width="{{ progress_percent | times: 5.96 }}" height="30" rx="7" fill="#000"/>
</svg>
{%- endcapture -%}

{%- capture title_icon -%}
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
  <circle cx="12" cy="12" r="9.2" fill="none" stroke="#000" stroke-width="2"
          stroke-linecap="round" stroke-dasharray="43 15" transform="rotate(-90 12 12)"/>
  <path d="M12 4.6v2.1M19.4 12h-2.1M12 19.4v-2.1M4.6 12h2.1M12 12l5-3.5"
        fill="none" stroke="#000" stroke-width="1.9" stroke-linecap="round"/>
  <circle cx="12" cy="12" r="1.8" fill="#000"/>
</svg>
{%- endcapture -%}

{% template title_bar %}
<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ title_icon | base64_encode }}" alt="">
  <span class="title">Life Clock</span>
  <span class="instance">{{ country_name | truncate: 24 }}{% if data_year %} · {{ data_year }}{% endif %}</span>
</div>
{% endtemplate %}
