{% if state == 'ok' %}
<div class="layout lc-layout lc-quadrant">
  <section>
    <img class="lc-clock w--32 lg:w--48" src="data:image/svg+xml;base64,{{ life_clock_svg | base64_encode }}" alt="Life Clock at {{ life_clock }}">
  </section>
  <section>
    <div class="label label--small lg:label--base lc-kicker">Life Clock</div>
    <div class="value value--large lg:value--xlarge value--tnums lc-time">{{ life_clock }}</div>
    <div class="description description--base lg:description--large lc-percent">{{ progress_percent }}%</div>
    <div class="description description--xsmall lg:description--small lc-note">{{ clock_remaining }} left{% if show_remaining %}<br>≈{{ remaining_display }} stat. years{% endif %}</div>
  </section>
</div>
{% else %}
<div class="layout lc-layout lc-error"><div class="title">{{ headline }}</div><div class="description description--small">{{ detail }}</div></div>
{% endif %}

<div class="title_bar">
  <span class="lc-title-icon">{{ title_icon }}</span>
  <span class="title">Life Clock</span>
  <span class="instance">{{ country_name | truncate: 24 }}{% if data_year %} · {{ data_year }}{% endif %}</span>
</div>
