{% if state == 'ok' %}
<div class="layout lc-layout lc-half-h">
  <section>
    <img class="lc-clock w--[180px] lg:w--[330px]" src="data:image/svg+xml;base64,{{ life_clock_svg | base64_encode }}" alt="Life Clock at {{ life_clock }}">
  </section>
  <section class="lc-half-h__right">
    <div class="label label--small lg:label--large lc-kicker">Lifetime in 24 hours</div>
    <div class="value value--xlarge lg:value--xxlarge value--tnums lc-time">{{ life_clock }}</div>
    <div class="description description--large lg:description--xlarge lc-percent">{{ progress_percent }}% lived</div>
    <img class="lc-progress h--[30px] lg:h--[46px]" src="data:image/svg+xml;base64,{{ progress_svg | base64_encode }}" alt="{{ progress_percent }} percent lived">
    <div class="description description--xsmall lg:description--small lc-note">{{ clock_remaining }} left on the statistical day{% if show_remaining %} · ≈{{ remaining_display }} stat. years{% endif %}</div>
  </section>
</div>
{% else %}
<div class="layout lc-layout lc-error"><div class="title title--large">{{ headline }}</div><div class="description">{{ detail }}</div></div>
{% endif %}

<div class="title_bar">
  <span class="lc-title-icon">{{ title_icon }}</span>
  <span class="title">Life Clock</span>
  <span class="instance">{{ country_name | truncate: 22 }}{% if data_year %} · {{ data_year }}{% endif %}</span>
</div>
