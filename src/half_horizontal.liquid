{% if state == 'ok' %}
<div class="layout layout--row layout--stretch-y gap--large">
  <section class="flex flex--center no-shrink w--48 lg:w--72">
    <img class="image w--40 lg:w--60" src="data:image/svg+xml;base64,{{ life_clock_svg | base64_encode }}" alt="Life Clock at {{ life_clock }}">
  </section>

  <section class="flex flex--col flex--left flex--center-y gap--xsmall lg:gap--small grow">
    <div class="label label--small lg:label--large text--bold">{{ labels.lifetime_24h }}</div>
    <div class="value value--large lg:value--xxlarge value--tnums" data-fit-value="true">{{ life_clock }}</div>
    <div class="description description--base lg:description--xlarge text--bold">{{ progress_display }}% {{ labels.lived }}</div>
    <img class="image w--full hidden lg:visible" src="data:image/svg+xml;base64,{{ progress_svg | base64_encode }}" alt="{{ progress_percent }} percent lived">
    <div class="description description--xsmall lg:description--small">
      <span class="lg:hidden">{% if show_remaining %}≈{{ remaining_display }} {{ labels.stat_years_left_short }}{% else %}{{ clock_remaining }} {{ labels.left }}{% endif %}</span>
      <span class="hidden lg:visible">{{ clock_remaining }} {{ labels.left_day }}{% if show_remaining %} · ≈{{ remaining_display }} {{ labels.stat_years }}{% endif %}</span>
    </div>
  </section>
</div>
{% else %}
<div class="layout layout--col layout--center gap--small">
  <div class="title title--large">{{ headline }}</div>
  <div class="description">{{ detail }}</div>
</div>
{% endif %}

{% render 'title_bar' with title_icon:title_icon, country_name:country_name, data_year:data_year %}
