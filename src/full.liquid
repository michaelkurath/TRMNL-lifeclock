{% if state == 'ok' %}
<div class="layout layout--col layout--stretch-x gap--large">
  <header class="flex flex--col flex--left gap--small w--full no-shrink">
    <div class="flex flex--row flex--between w--full">
      <span class="label label--small lg:label--large text--bold">{{ labels.lifetime_24h }}</span>
      <span class="label label--small lg:label--large text--bold">{{ country_name | truncate: 28 }}</span>
    </div>
    <div class="divider"></div>
  </header>

  <main class="grid grid--cols-12 gap--xlarge stretch">
    <section class="col--span-5 flex flex--center">
      <img class="image w--72 lg:w--96" src="data:image/svg+xml;base64,{{ life_clock_svg | base64_encode }}" alt="Life Clock at {{ life_clock }}">
    </section>

    <section class="col--span-7 flex flex--col flex--left flex--between gap--large">
      <div class="flex flex--col flex--left gap--small">
        <div class="value value--xxlarge lg:value--xxxlarge value--tnums" data-fit-value="true">{{ life_clock }}</div>
        <div class="description description--large lg:description--xlarge text--bold">{{ progress_display }}% {{ labels.lived }}</div>
      </div>

      <div class="flex flex--col flex--left gap--small w--full">
        <img class="image w--full h--8 lg:h--14" src="data:image/svg+xml;base64,{{ progress_svg | base64_encode }}" alt="{{ progress_percent }} percent of the current statistical lifetime lived">
        <div class="description description--small lg:description--base">{{ clock_remaining }} {{ labels.remains_day }}</div>
      </div>

      <div class="grid {% if show_remaining %}grid--cols-3{% else %}grid--cols-2{% endif %} gap--large w--full">
        <div class="flex flex--col flex--left gap--xsmall">
          <div class="divider"></div>
          <div class="value value--base lg:value--large value--tnums" data-fit-value="true">{{ age_display }}</div>
          <div class="label label--small lg:label--base">{{ labels.age_now }}</div>
        </div>
        {% if show_remaining %}
        <div class="flex flex--col flex--left gap--xsmall">
          <div class="divider"></div>
          <div class="value value--base lg:value--large value--tnums" data-fit-value="true">{{ remaining_display }}</div>
          <div class="label label--small lg:label--base">{{ labels.stat_years_left }}</div>
        </div>
        {% endif %}
        <div class="flex flex--col flex--left gap--xsmall">
          <div class="divider"></div>
          <div class="value value--base lg:value--large value--tnums" data-fit-value="true">{{ expected_age_display }}</div>
          <div class="label label--small lg:label--base">{{ labels.stat_lifetime }}</div>
        </div>
      </div>

      <div class="description description--xsmall lg:description--small">
        {{ detail }}{% if show_horizon %} · {{ labels.stat_horizon }} ~{{ horizon_year }}{% endif %}
        {% if data_stale %}<br>{{ labels.life_table_year }}: {{ data_year }}.{% endif %}
        {% if prototype %}<br><strong>{{ labels.prototype_warning }}</strong>{% endif %}
      </div>
    </section>
  </main>
</div>
{% else %}
<div class="layout layout--col layout--center gap--large">
  <div class="title title--large lg:title--xlarge">{{ headline }}</div>
  <div class="description lg:description--large">{{ detail }}</div>
</div>
{% endif %}

{% render 'title_bar' with title_icon:title_icon, country_name:country_name, data_year:data_year %}
